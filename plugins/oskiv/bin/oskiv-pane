#!/bin/sh
# The only way the loop touches its worker panes. Drives tmux; run it from inside the tmux
# session that holds the orchestrator (`tmux -CC new -A -s <name>` in iTerm2 shows it natively).
#
#   oskiv-pane new-tab              open a tmux window (an iTerm2 tab under -CC); print its pane id
#   oskiv-pane split <id>           split that pane side by side; print the new pane id
#   oskiv-pane send <id> <text>     type one line into the pane and press Enter
#   oskiv-pane read <id>            print the pane's last 200 lines (the status line included)
#   oskiv-pane busy <id>            print true if the pane's screen changes within a second, else false
#   oskiv-pane exit <id>            type /exit into the pane

set -eu

usage() { sed -n '5,10p' "$0" | sed 's/^# *//' >&2; exit 2; }

[ $# -ge 1 ] || usage
verb=$1; shift

case $verb in
  new-tab) [ $# -eq 0 ] || usage ;;
  split|read|busy|exit) [ $# -eq 1 ] || usage ;;
  send)
    [ $# -eq 2 ] || usage
    case $2 in *"
"*) echo "oskiv-pane: send takes one line; send longer text by SendMessage" >&2; exit 2 ;; esac
    ;;
  *) usage ;;
esac

if [ -z "${TMUX:-}" ]; then
  echo "oskiv-pane: not inside tmux. Start the orchestrator in iTerm2 with: tmux -CC new -A -s <name>" >&2
  exit 1
fi

# Pane ids look like %12; refuse anything else so a target can't be another session or window.
if [ $# -ge 1 ]; then
  case $1 in %[0-9]*) ;; *) echo "oskiv-pane: pane id must look like %12" >&2; exit 2 ;; esac
fi

type_line() {
  tmux send-keys -t "$1" -l -- "$2"
  sleep 0.3  # let the app take the text before Enter, so Enter isn't read as part of a paste
  tmux send-keys -t "$1" Enter
}

case $verb in
  new-tab) tmux new-window -P -F '#{pane_id}' -c "$PWD" ;;
  split)   tmux split-window -h -t "$1" -P -F '#{pane_id}' -c "$PWD" ;;
  send)    type_line "$1" "$2" ;;
  read)    # drop the blank rows below the last output, so `tail` shows the status line
    tmux capture-pane -p -J -t "$1" -S -200 | awk 'NF { while (n > 0) { print ""; n-- } print; next } { n++ }' ;;
  busy)
    a=$(tmux capture-pane -p -t "$1")
    sleep 1
    b=$(tmux capture-pane -p -t "$1")
    if [ "$a" = "$b" ]; then echo false; else echo true; fi
    ;;
  exit)    type_line "$1" "/exit" ;;
esac
